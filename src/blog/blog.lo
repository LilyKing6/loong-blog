}

impure fn postCommentsRoute(ctx: RouteContext) -> HttpResp {
  (
    slug = ctx.queryField("slug") ?? "";
    if (getPostBySlug(slug) as Post post) {
      comments = getCommentsForPost(post.id);
      jsonOk(
        jsonObject(
          jsonField("postSlug", slug) ::
          jsonField("count", JsonValue(comments.length())) ::
          jsonField("comments", comments.commentsJson())
        )
      )
    } else {
      notFoundResp("/api/blog/posts/comments?slug=" + slug)
    }
  )
}

impure fn commentCreateRoute(ctx: RouteContext) -> HttpResp {
  (
    slug = ctx.queryField("slug") ?? "";
    authorName = ctx.requestField("authorName") ?? "Anonymous";
    body = ctx.requestField("body") ?? "";
    parentIdStr = ctx.requestField("parentId") ?? "0";
    parentId = txtIntParser()(parentIdStr) ?? 0;
    post = getPostBySlug(slug);
    if (post as Post p) {
      c = createComment(p.id, authorName, body, parentId, "published");
      jsonResp(
        HttpStatusCode.Created,
        jsonObject(
          jsonField("status", "created") ::
          jsonField("comment", c.commentJson())
        )
      )
    } else {
      notFoundResp("/api/blog/posts/comments?slug=" + slug)
    }
  )
}

impure fn commentDeleteRoute(ctx: RouteContext) -> HttpResp {
  (
    auth = ctx.requirePermission("blog.write");
    if (auth as HttpResp resp) {
      resp
    } else if (auth as SessionUser user) {
      (
        idStr = ctx.queryField("id") ?? "";
        id = txtIntParser()(idStr) ?? 0;
        if (deleteComment(id) as Comment c) {
          jsonOk(
            jsonObject(
              jsonField("status", "deleted") ::
              jsonField("commentId", JsonValue(id)) ::
              jsonField("deletedBy", user.name)
            )
          )
        } else {
