impure fn blogRoutes() -> List<HttpRoute> {
  routeGroup(
    "/api/blog",
    HttpRoute(HttpMethod.Get, "/health", impure [](ctx: RouteContext) -> HttpResp { blogHealth(ctx) }) ::
    HttpRoute(HttpMethod.Get, "/posts",  impure [](ctx: RouteContext) -> HttpResp { postListRoute(ctx) }) ::
    HttpRoute(HttpMethod.Get, "/post",  impure [](ctx: RouteContext) -> HttpResp { postDetailRoute(ctx) }) ::
    HttpRoute(HttpMethod.Post, "/posts",  impure [](ctx: RouteContext) -> HttpResp { postCreateRoute(ctx) }) ::
    HttpRoute(HttpMethod.Put, "/posts",  impure [](ctx: RouteContext) -> HttpResp { postUpdateRoute(ctx) }) ::
    HttpRoute(HttpMethod.Patch, "/posts",  impure [](ctx: RouteContext) -> HttpResp { postUpdateRoute(ctx) }) ::
    HttpRoute(HttpMethod.Post, "/posts/publish",  impure [](ctx: RouteContext) -> HttpResp { postStatusRoute(ctx, "published") }) ::
    HttpRoute(HttpMethod.Post, "/posts/draft",  impure [](ctx: RouteContext) -> HttpResp { postStatusRoute(ctx, "draft") }) ::
    HttpRoute(HttpMethod.Delete, "/posts",  impure [](ctx: RouteContext) -> HttpResp { postDeleteRoute(ctx) }) ::
    HttpRoute(HttpMethod.Get, "/categories",  impure [](ctx: RouteContext) -> HttpResp { categoryListRoute(ctx) }) ::
    HttpRoute(HttpMethod.Post, "/categories",  impure [](ctx: RouteContext) -> HttpResp { categoryCreateRoute(ctx) }) ::
    HttpRoute(HttpMethod.Get, "/category",  impure [](ctx: RouteContext) -> HttpResp { categoryDetailRoute(ctx) }) ::
    HttpRoute(HttpMethod.Put, "/categories",  impure [](ctx: RouteContext) -> HttpResp { categoryUpdateRoute(ctx) }) ::
    HttpRoute(HttpMethod.Delete, "/categories",  impure [](ctx: RouteContext) -> HttpResp { categoryDeleteRoute(ctx) }) ::
    HttpRoute(HttpMethod.Get, "/tags",  impure [](ctx: RouteContext) -> HttpResp { tagListRoute(ctx) }) ::
    HttpRoute(HttpMethod.Post, "/tags",  impure [](ctx: RouteContext) -> HttpResp { tagCreateRoute(ctx) }) ::
    HttpRoute(HttpMethod.Get, "/tag",  impure [](ctx: RouteContext) -> HttpResp { tagDetailRoute(ctx) }) ::
    HttpRoute(HttpMethod.Put, "/tags",  impure [](ctx: RouteContext) -> HttpResp { tagUpdateRoute(ctx) }) ::
    HttpRoute(HttpMethod.Delete, "/tags",  impure [](ctx: RouteContext) -> HttpResp { tagDeleteRoute(ctx) }) ::
    HttpRoute(HttpMethod.Post, "/posts/category",  impure [](ctx: RouteContext) -> HttpResp { postSetCategoryRoute(ctx) }) ::
    HttpRoute(HttpMethod.Post, "/posts/tag",  impure [](ctx: RouteContext) -> HttpResp { postAddTagRoute(ctx) }) ::
    HttpRoute(HttpMethod.Post, "/posts/tag/remove",  impure [](ctx: RouteContext) -> HttpResp { postRemoveTagRoute(ctx) }) ::
    HttpRoute(HttpMethod.Get, "/posts/by-category",  impure [](ctx: RouteContext) -> HttpResp { postsByCategoryRoute(ctx) }) ::
    HttpRoute(HttpMethod.Get, "/posts/by-tag",  impure [](ctx: RouteContext) -> HttpResp { postsByTagRoute(ctx) }) ::
    HttpRoute(HttpMethod.Get, "/posts/comments",  impure [](ctx: RouteContext) -> HttpResp { postCommentsRoute(ctx) }) ::
    HttpRoute(HttpMethod.Post, "/posts/comments",  impure [](ctx: RouteContext) -> HttpResp { commentCreateRoute(ctx) }) ::
    HttpRoute(HttpMethod.Delete, "/posts/comments",  impure [](ctx: RouteContext) -> HttpResp { commentDeleteRoute(ctx) }) ::
    HttpRoute(HttpMethod.Get, "/posts/search",  impure [](ctx: RouteContext) -> HttpResp { postSearchRoute(ctx) }) ::
    HttpRoute(HttpMethod.Get, "/posts/revisions",  impure [](ctx: RouteContext) -> HttpResp { postRevisionsRoute(ctx) }) ::
    HttpRoute(HttpMethod.Get, "/posts/revision",  impure [](ctx: RouteContext) -> HttpResp { postRevisionRoute(ctx) })
  )
}

impure fn serveBlog(s: ServerSettings) -> Option<Error> {
  serveWithRoutes(s, blogRoutes())
}
