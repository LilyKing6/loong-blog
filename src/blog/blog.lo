fn postJson(post: Post) -> JsonValue {
  jsonObject(
    jsonField("id", JsonValue(post.id)) ::
    jsonField("slug", post.slug) ::
    jsonField("title", post.title) ::
    jsonField("body", post.body) ::
    jsonField("status", post.status) ::
    jsonField("publishedAt", post.publishedAt) ::
    jsonField("categoryId", JsonValue(post.categoryId)) ::
    jsonField("tagIds", jsonArray(post.tagIds.map([](tid: int) JsonValue(tid))))
  )
}

fn postsJson(posts: List<Post>) -> JsonValue {
  jsonArray(posts.map([](post: Post) post.postJson()))
}

fn categoryJson(cat: Category) -> JsonValue {
  jsonObject(
    jsonField("id", JsonValue(cat.id)) ::
    jsonField("slug", cat.slug) ::
    jsonField("name", cat.name)
  )
}

fn categoriesJson(cats: List<Category>) -> JsonValue {
  jsonArray(cats.map([](cat: Category) cat.categoryJson()))
}

fn tagJson(tag: Tag) -> JsonValue {
  jsonObject(
    jsonField("id", JsonValue(tag.id)) ::
    jsonField("slug", tag.slug) ::
    jsonField("name", tag.name)
  )
}

fn tagsJson(tags: List<Tag>) -> JsonValue {
  jsonArray(tags.map([](tag: Tag) tag.tagJson()))
}

fn bodyField(ctx: RouteContext, key: string) -> Option<string> {
  ctx.body.parseFormFields().formValue(key)
}

fn queryField(ctx: RouteContext, key: string) -> Option<string> {
  ctx.path.queryFields().formValue(key)
}

fn requestField(ctx: RouteContext, key: string) -> Option<string> {
  ctx.bodyField(key) ?? ctx.queryField(key)
}

fn requestedSlug(ctx: RouteContext) -> string {
  ctx.requestField("slug") ?? "hello-loong"
}

fn slugFromTitle(title: string) -> string {
  title.trim().replace(" ", "-")
}

fn isPostStatus(status: string) -> bool {
  status == "draft" || status == "published" || status == "archived"
}

fn normalizePostStatus(status: string) -> string {
  if (status.trim().isEmpty()) { "draft" } else { status.trim() }
}

fn publishedAtForStatus(status: string) -> string {
  if (status == "published") { "demo-now" } else { "" }
}

fn postWithStatus(post: Post, status: string) -> Post {
  Post(post.id, post.slug, post.title, post.body, status, status.publishedAtForStatus(), post.categoryId, post.tagIds)
}

impure fn postListRoute(ctx: RouteContext) -> HttpResp {
  (
    status = ctx.requestField("status") ?? "all";
    posts = listPostsByStatus(status);
    jsonOk(
      jsonObject(
        jsonField("title", "Loong Blog") ::
        jsonField("status", status) ::
        jsonField("count", JsonValue(posts.length())) ::
        jsonField("posts", posts.postsJson())
      )
    )
  )
}

impure fn postDetailRoute(ctx: RouteContext) -> HttpResp {
  (
    slug = ctx.requestedSlug();
    if (getPostBySlug(slug) as Post post) {
      jsonOk(post.postJson())
    } else {
      notFoundResp("/api/blog/post?slug=" + slug)
    }
  )
}

impure fn postCreateRoute(ctx: RouteContext) -> HttpResp {
  (
    auth = ctx.requirePermission("blog.write");
    if (auth as HttpResp resp) {
      resp
    } else if (auth as SessionUser user) {
      (
        title = ctx.requestField("title") ?? "Untitled Post";
        body = ctx.requestField("body") ?? ctx.body;
        slug = ctx.requestField("slug") ?? title.slugFromTitle();
        status = (ctx.requestField("status") ?? "draft").normalizePostStatus();
        categoryIdStr = ctx.requestField("categoryId") ?? "0";
        categoryId = txtIntParser()(categoryIdStr) ?? 0;
        tagIdsStr = ctx.requestField("tagIds") ?? "";
        tagIds = if (tagIdsStr.isEmpty()) {
          List<int>()
        } else {
          tagIdsStr.split(equals<char>[',']).filter([](s: string) -> bool { !s.trim().isEmpty() }).map([](s: string) -> int { txtIntParser()(s.trim()) ?? 0 })
        };
        if (!status.isPostStatus()) {
          badRequestResp("Invalid post status: " + status)
        } else {
          (
            newPost = Post(0, slug, title, body, status, status.publishedAtForStatus(), categoryId, tagIds);
            created = createPost(newPost);
            jsonResp(
              HttpStatusCode.Created,
              jsonObject(
                jsonField("status", "created") ::
                jsonField("post", created.postJson()) ::
                jsonField("author", user.name)
              )
            )
          )
        }
      )
    } else {
      unauthorizedResp("Authentication required")
    }
  )
}

impure fn postUpdateRoute(ctx: RouteContext) -> HttpResp {
  (
    auth = ctx.requirePermission("blog.write");
    if (auth as HttpResp resp) {
      resp
    } else if (auth as SessionUser user) {
      (
        slug = ctx.requestedSlug();
        if (getPostBySlug(slug) as Post existing) {
          (
            title = ctx.requestField("title") ?? existing.title;
            body = ctx.requestField("body") ?? existing.body;
            newSlug = ctx.requestField("newSlug") ?? slug;
            status = (ctx.requestField("status") ?? existing.status).normalizePostStatus();
            if (!status.isPostStatus()) {
              badRequestResp("Invalid post status: " + status)
            } else {
              (
                rev = createRevision(0, existing.id, existing.body);
                updated = Post(existing.id, newSlug, title, body, status, status.publishedAtForStatus(), existing.categoryId, existing.tagIds);
                updatePost(slug, updated);
                jsonOk(
                  jsonObject(
                    jsonField("status", "updated") ::
                    jsonField("post", updated.postJson()) ::
                    jsonField("updatedBy", user.name)
                  )
                )
              )
            }
          )
        } else {
          notFoundResp("/api/blog/posts?slug=" + slug)
        }
      )
    } else {
      unauthorizedResp("Authentication required")
    }
  )
}

impure fn postStatusRoute(ctx: RouteContext, nextStatus: string) -> HttpResp {
  (
    auth = ctx.requirePermission("blog.write");
    if (auth as HttpResp resp) {
      resp
    } else if (auth as SessionUser user) {
      (
        slug = ctx.requestedSlug();
        if (getPostBySlug(slug) as Post existing) {
          (
            updated = existing.postWithStatus(nextStatus);
            updatePost(slug, updated);
            jsonOk(
              jsonObject(
                jsonField("status", nextStatus) ::
                jsonField("post", updated.postJson()) ::
                jsonField("updatedBy", user.name)
              )
            )
          )
        } else {
          notFoundResp("/api/blog/posts?slug=" + slug)
        }
      )
    } else {
      unauthorizedResp("Authentication required")
    }
  )
}

impure fn postDeleteRoute(ctx: RouteContext) -> HttpResp {
  (
    auth = ctx.requirePermission("blog.write");
    if (auth as HttpResp resp) {
      resp
    } else if (auth as SessionUser user) {
      (
        slug = ctx.requestedSlug();
        if (deletePost(slug) as Post post) {
          jsonOk(
            jsonObject(
              jsonField("status", "deleted") ::
              jsonField("slug", post.slug) ::
              jsonField("deletedBy", user.name)
            )
          )
        } else {
          notFoundResp("/api/blog/posts?slug=" + slug)
        }
      )
    } else {
      unauthorizedResp("Authentication required")
    }
  )
}

impure fn postSetCategoryRoute(ctx: RouteContext) -> HttpResp {
  (
    auth = ctx.requirePermission("blog.write");
    if (auth as HttpResp resp) {
      resp
    } else if (auth as SessionUser user) {
      slug = ctx.queryField("slug") ?? "";
      categoryId = ctx.requestField("categoryId") ?? "";
      if (getPostBySlug(slug) as Post existing) {
        cid = txtIntParser()(categoryId) ?? existing.categoryId;
        updated = Post(existing.id, existing.slug, existing.title, existing.body, existing.status, existing.publishedAt, cid, existing.tagIds);
        updatePost(slug, updated);
        jsonOk(
          jsonObject(
            jsonField("status", "category-updated") ::
            jsonField("post", updated.postJson()) ::
            jsonField("updatedBy", user.name)
          )
        )
      } else {
        notFoundResp("/api/blog/posts?slug=" + slug)
      }
    } else {
      unauthorizedResp("Authentication required")
    }
  )
}

impure fn postAddTagRoute(ctx: RouteContext) -> HttpResp {
  (
    auth = ctx.requirePermission("blog.write");
    if (auth as HttpResp resp) {
      resp
    } else if (auth as SessionUser user) {
      slug = ctx.queryField("slug") ?? "";
      tagId = ctx.requestField("tagId") ?? "";
      if (getPostBySlug(slug) as Post existing) {
        tid = txtIntParser()(tagId) ?? 0;
        newTagIds = existing.tagIds :: tid;
        updated = Post(existing.id, existing.slug, existing.title, existing.body, existing.status, existing.publishedAt, existing.categoryId, newTagIds);
        updatePost(slug, updated);
        jsonOk(
          jsonObject(
            jsonField("status", "tag-added") ::
            jsonField("post", updated.postJson()) ::
            jsonField("updatedBy", user.name)
          )
        )
      } else {
        notFoundResp("/api/blog/posts?slug=" + slug)
      }
    } else {
      unauthorizedResp("Authentication required")
    }
  )
}

impure fn postRemoveTagRoute(ctx: RouteContext) -> HttpResp {
  (
    auth = ctx.requirePermission("blog.write");
    if (auth as HttpResp resp) {
      resp
    } else if (auth as SessionUser user) {
      slug = ctx.queryField("slug") ?? "";
      tagId = ctx.requestField("tagId") ?? "";
      if (getPostBySlug(slug) as Post existing) {
        tid = txtIntParser()(tagId) ?? 0;
        newTagIds = existing.tagIds.filter([tid] (t: int) -> bool { t != tid });
        updated = Post(existing.id, existing.slug, existing.title, existing.body, existing.status, existing.publishedAt, existing.categoryId, newTagIds);
        updatePost(slug, updated);
        jsonOk(
          jsonObject(
            jsonField("status", "tag-removed") ::
            jsonField("post", updated.postJson()) ::
            jsonField("updatedBy", user.name)
          )
        )
      } else {
        notFoundResp("/api/blog/posts?slug=" + slug)
      }
    } else {
      unauthorizedResp("Authentication required")
    }
  )
}

impure fn postsByCategoryRoute(ctx: RouteContext) -> HttpResp {
  categorySlug = ctx.queryField("slug") ?? "";
  if (getCategoryBySlug(categorySlug) as Category cat) {
    filtered = listPostsByStatus("all").filter([cat] (post: Post) -> bool { post.categoryId == cat.id });
    jsonOk(
      jsonObject(
        jsonField("category", cat.categoryJson()) ::
        jsonField("count", JsonValue(filtered.length())) ::
        jsonField("posts", filtered.postsJson())
      )
    )
  } else {
    notFoundResp("/api/blog/posts/by-category?slug=" + categorySlug)
  }
}

impure fn postsByTagRoute(ctx: RouteContext) -> HttpResp {
  tagSlug = ctx.queryField("slug") ?? "";
  if (getTagBySlug(tagSlug) as Tag tag) {
    filtered = listPostsByStatus("all").filter([tag] (post: Post) -> bool { post.tagIds.contains(tag.id) });
    jsonOk(
      jsonObject(
        jsonField("tag", tag.tagJson()) ::
        jsonField("count", JsonValue(filtered.length())) ::
        jsonField("posts", filtered.postsJson())
      )
    )
  } else {
    notFoundResp("/api/blog/posts/by-tag?slug=" + tagSlug)
  }
}

impure fn blogHealth(ctx: RouteContext) -> HttpResp {
