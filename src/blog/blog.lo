}

impure fn postSearchRoute(ctx: RouteContext) -> HttpResp {
  (
    q = ctx.queryField("q") ?? "";
    if (q.isEmpty()) {
      badRequestResp("Search query 'q' is required")
    } else {
      results = allPosts().filter([q] (post: Post) -> bool {
        post.title.contains(q) || post.body.contains(q)
      });
      jsonOk(
        jsonObject(
          jsonField("query", q) ::
          jsonField("count", JsonValue(results.length())) ::
          jsonField("posts", results.postsJson())
        )
      )
    }
  )
}

