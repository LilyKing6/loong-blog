<% if (error) { %>
  <div class="error-page">
    <h2>Cannot connect to backend</h2>
    <p><%= error %></p>
    <p>Make sure the Loong blog server is running on port 8080.</p>
  </div>
<% } else { %>
  <section class="hero">
    <p class="eyebrow">Loong Web Framework</p>
    <h1>A blog built on Loong.</h1>
    <p>Writing, sharing, and documenting — all powered by a Loong web server. <%= posts.length %> published posts.</p>
    <div class="hero-actions">
      <a href="/posts" class="btn btn-primary">Explore Posts</a>
      <a href="/docs" class="btn btn-ghost">Read Docs</a>
    </div>
  </section>

  <% if (posts.length > 0) { %>
    <div class="post-list">
      <h2>Recent Posts</h2>
      <% posts.forEach(function(p) { %>
        <div class="post-card fade-in">
          <h3><a href="/post?slug=<%= encodeURIComponent(p.slug) %>"><%= p.title %></a></h3>
          <div class="post-meta">
            <span><%= formatDate(p.publishedAt) %></span>
            <span><%= p.status %></span>
          </div>
          <div class="post-excerpt"><%= excerpt(p.body) %></div>
          <% if (p.tags && p.tags.length > 0) { %>
            <div class="post-tags">
              <% p.tags.forEach(function(t) { %>
                <a class="tag" href="/posts?tag=<%= encodeURIComponent(t.slug) %>"><%= t.name %></a>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p>No published posts yet.</p>
  <% } %>

  <div class="stats-grid">
    <% if (categories.length > 0) { %>
      <div class="sidebar-section" style="flex:1;min-width:200px">
        <h4>Categories</h4>
        <% categories.forEach(function(c) { %>
          <a href="/posts?category=<%= encodeURIComponent(c.slug) %>"><%= c.name %></a>
        <% }) %>
      </div>
    <% } %>
    <% if (tags.length > 0) { %>
      <div class="sidebar-section" style="flex:1;min-width:200px">
        <h4>Tags</h4>
        <% tags.forEach(function(t) { %>
          <a href="/posts?tag=<%= encodeURIComponent(t.slug) %>"><%= t.name %></a>
        <% }) %>
      </div>
    <% } %>
  </div>
<% } %>
