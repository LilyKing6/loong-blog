<% if (error) { %>
  <div class="error-page">
    <h2>Oops</h2>
    <p><%= error %></p>
  </div>
<% } else { %>
  <div class="post-list">
    <h2><%= filterLabel %> (<%= posts.length %>)</h2>
    <% if (posts.length === 0) { %>
      <p>No posts found.</p>
    <% } else { %>
      <% posts.forEach(function(p) { %>
        <div class="post-card fade-in">
          <h3><a href="/post?slug=<%= encodeURIComponent(p.slug) %>"><%= p.title %></a></h3>
          <div class="post-meta">
            <span><%= formatDate(p.publishedAt) %></span>
            <span class="post-status"><%= p.status %></span>
          </div>
          <div class="post-excerpt"><%= excerpt(p.body) %></div>
          <% if (p.tags && p.tags.length > 0) { %>
            <div class="post-tags">
              <% p.tags.forEach(function(t) { %>
                <a class="tag" href="/posts?tag=<%= encodeURIComponent(t.slug) %>"><%= t.name %></a>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
    <% } %>
    <% if (posts.length > 10) { %>
    <div class="pagination">
      <% const perPage = 10; const totalPages = Math.ceil(posts.length / perPage); %>
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %>" class="<%= i === 1 ? 'active' : '' %>"><%= i %></a>
      <% } %>
    </div>
    <% } %>
  </div>
<% } %>
