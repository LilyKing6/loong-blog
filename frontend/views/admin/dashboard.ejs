<h2>Dashboard</h2>
<div class="admin-stats">
  <div class="admin-stat">
    <div class="stat-number"><%= posts.length %></div>
    <div class="stat-label">Posts</div>
    <div class="stat-action"><a href="/admin/posts" class="product_btn small">Manage</a></div>
  </div>
  <div class="admin-stat">
    <div class="stat-number"><%= categories.length %></div>
    <div class="stat-label">Categories</div>
    <div class="stat-action"><a href="/admin/categories" class="product_btn small">Manage</a></div>
  </div>
  <div class="admin-stat">
    <div class="stat-number"><%= tags.length %></div>
    <div class="stat-label">Tags</div>
    <div class="stat-action"><a href="/admin/tags" class="product_btn small">Manage</a></div>
  </div>
</div><h2 style="margin-top:32px">Recent Posts</h2>
<table class="admin-table">
  <thead><tr><th>Title</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead>
  <tbody>
    <% posts.slice(0, 10).forEach(function(p) { %>
      <tr>
        <td><a href="/post?slug=<%= encodeURIComponent(p.slug) %>"><%= p.title %></a></td>
        <td><%= p.status %></td>
        <td><%= formatDate(p.publishedAt) %></td>
        <td>
          <a href="/admin/posts/<%= encodeURIComponent(p.slug) %>/edit" class="product_btn ghost small">Edit</a>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
