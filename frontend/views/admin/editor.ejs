<h2><%= post ? 'Edit Post' : 'New Post' %></h2>
<form class="admin-form" action="/admin/posts/save" method="POST" style="max-width:none">
  <% if (post) { %><input type="hidden" name="existingSlug" value="<%= post.slug %>"><% } %>
  <label>Title</label>
  <input type="text" name="title" value="<%= post ? post.title : '' %>" required>
  <label>Slug</label>
  <input type="text" name="slug" value="<%= post ? post.slug : '' %>" placeholder="url-friendly-slug">
  <label>Status</label>
  <select name="status">
    <option value="draft" <%= post && post.status === 'draft' ? 'selected' : '' %>>Draft</option>
    <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Published</option>
  </select>
  <label>Category</label>
  <select name="categoryId">
    <option value="0">— None —</option>
    <% categories.forEach(function(c) { %>
      <option value="<%= c.id %>" <%= post && post.categoryId == c.id ? 'selected' : '' %>><%= c.name %></option>
    <% }) %>
  </select>
  <label>Body (Markdown)</label>
  <div style="margin-bottom:8px;display:flex;gap:8px;align-items:center">
    <label class="product_btn ghost" style="cursor:pointer;display:inline-block;padding:6px 14px;font-size:13px;margin:0">
      📎 Upload Image
      <input type="file" id="image-upload" accept="image/*" style="display:none" onchange="handleImageUpload(this)">
    </label>
    <span id="upload-status" style="font-size:12px;color:#8a9e8a"></span>
  </div>
  <div class="editor-container">
    <div class="editor-pane">
      <h4>Editor</h4>
      <textarea name="body" id="editor-body" oninput="renderPreview()"><%= post ? post.body : '' %></textarea>
    </div>
    <div class="editor-pane">
      <h4>Preview</h4>
      <div class="editor-preview" id="editor-preview"></div>
    </div>
  </div>
  <div class="form-actions">
    <button type="submit" class="product_btn"><%= post ? 'Update' : 'Create' %></button>
    <a href="/admin/posts" class="product_btn ghost">Cancel</a>
  </div>
</form>
<script>
async function handleImageUpload(input) {
  const file = input.files[0];
  if (!file) return;
  const status = document.getElementById('upload-status');
  status.textContent = 'Uploading...';
  try {
    const formData = new FormData();
    formData.append('file', file);
    const res = await fetch('/api/uploads?filename=' + encodeURIComponent(file.name), {
      method: 'POST',
      body: file
    });
    if (!res.ok) throw new Error('Upload failed');
    const data = await res.json();
    const textarea = document.getElementById('editor-body');
    const markdown = '\n![](' + data.url + ')\n';
    const pos = textarea.selectionStart;
    textarea.value = textarea.value.substring(0, pos) + markdown + textarea.value.substring(pos);
    textarea.selectionStart = textarea.selectionEnd = pos + markdown.length;
    renderPreview();
    status.textContent = 'Uploaded: ' + data.url;
  } catch (e) {
    status.textContent = 'Error: ' + e.message;
  }
  input.value = '';
}

function renderPreview() {
  const md = document.getElementById('editor-body').value;
  const preview = document.getElementById('editor-preview');
  // Inline markdown render (mirrors server-side logic)
  let html = md
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/```(\w*)\n([\s\S]*?)```/g, (m,l,c) => '<pre><code>'+c.replace(/\n$/,'')+'</code></pre>')
    .replace(/^### (.+)$/gm,'<h3>$1</h3>')
    .replace(/^## (.+)$/gm,'<h2>$1</h2>')
    .replace(/^# (.+)$/gm,'<h1>$1</h1>')
    .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
    .replace(/\*(.+?)\*/g,'<em>$1</em>')
    .replace(/`([^`]+)`/g,'<code>$1</code>')
    .replace(/^---$/gm,'<hr>')
    .replace(/^> (.+)$/gm,'<blockquote>$1</blockquote>')
    .replace(/^- (.+)$/gm,'<li>$1</li>')
    .replace(/(<li>.*<\/li>\n?)+/g,'<ul>$&</ul>')
    .replace(/\n{2,}/g,'</p><p>').replace(/\n/g,' ');
  html = '<p>'+html+'</p>';
  html = html.replace(/<p>\s*<\/p>/g,'');
  html = html.replace(/<p>(<h[1-3]>)/g,'$1').replace(/(<\/h[1-3]>)<\/p>/g,'$1');
  html = html.replace(/<p>(<pre>)/g,'$1').replace(/(<\/pre>)<\/p>/g,'$1');
  html = html.replace(/<p>(<ul>)/g,'$1').replace(/(<\/ul>)<\/p>/g,'$1');
  html = html.replace(/<p>(<blockquote>)/g,'$1').replace(/(<\/blockquote>)<\/p>/g,'$1');
  html = html.replace(/<p>(<hr>)<\/p>/g,'$1');
  preview.innerHTML = html;
}
renderPreview();
</script>
